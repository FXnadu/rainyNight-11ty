    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{ title | formatTitle(siteConfig.meta.title) }}</title>
    <meta name="description" content="{{ description or siteConfig.meta.description }}">
    <link rel="preconnect" href="https://fonts.loli.net">
    <link rel="preconnect" href="https://gstatic.loli.net" crossorigin>
    <link rel="stylesheet" href="{{ siteConfig.external.fonts }}">
    {% if env.ELEVENTY_ENV == "production" and build and build.cssBundleHash %}
        <link rel="stylesheet" href="/assets/css/bundle.css?v={{ build.cssBundleHash }}">
    {% else %}
        <link rel="stylesheet" href="/assets/css/foundation.css?v=20260416-2">
        <link rel="stylesheet" href="/assets/css/layout.css?v=20260416-2">
        <link rel="stylesheet" href="/assets/css/components.css?v=20260416-2">
    {% endif %}
    <script>
        (function() {
            const configuredDefaultTheme = "{{ siteConfig.theme.default | default('light') }}";
            const defaultTheme = configuredDefaultTheme === "dark" ? "dark" : "light";
            const savedTheme = localStorage.getItem('theme');
            const initialTheme = savedTheme === "light" || savedTheme === "dark"
                ? savedTheme
                : defaultTheme;
            document.documentElement.setAttribute("data-theme", initialTheme);
        })();
    </script>
    {% if pageStyles %}
        {% for href in pageStyles %}
            <link rel="stylesheet" href="{{ href }}" data-page-style>
        {% endfor %}
    {% endif %}
